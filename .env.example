# Copy to .env (git-ignored) and fill in. Real environment variables take precedence.
# run_jobs.py passes these on to the other projects' publish scripts too.

# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Without it the market job falls back to FRED's keyless CSV endpoint (slower, less reliable).
# The macro-regime-nowcaster publisher needs it.
FRED_API_KEY=

# Optional: the Analyst page (nightly brief + chat). Without it the "analyst" job is skipped.
ANTHROPIC_API_KEY=
